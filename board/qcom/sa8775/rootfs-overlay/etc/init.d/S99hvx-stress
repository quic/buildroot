#!/bin/sh
#
# Copyright (c) 2026, Qualcomm Innovation Center, Inc. All rights reserved.
# SPDX-License-Identifier: BSD-3-Clause
#
# Run the HVX stress suite at boot, but only when explicitly asked for on the
# kernel command line, so ordinary boots are unaffected:
#
#   hvxstress          run with the default iteration count
#   hvxstress=N        run N iterations per worker
#   hvxstress.poweroff powers the machine off when finished, which under QEMU
#                      exits the emulator (the kernel uses semihosting to exit
#                      on power off)
#
# The verdict is printed to the console as a single HVX-STRESS: PASS or
# HVX-STRESS: FAIL line.

DEFAULT_ITERATIONS=10

start()
{
	cmdline=$(cat /proc/cmdline 2>/dev/null)
	iterations=""
	poweroff_when_done=no

	for arg in $cmdline; do
		case "$arg" in
		hvxstress)
			iterations=$DEFAULT_ITERATIONS
			;;
		hvxstress=*)
			iterations=${arg#hvxstress=}
			;;
		hvxstress.poweroff)
			poweroff_when_done=yes
			;;
		esac
	done

	[ -n "$iterations" ] || exit 0

	if ! [ -x /usr/bin/hvx-stress-run ]; then
		echo "HVX-STRESS: FAIL (hvx-stress-run not installed)"
		[ "$poweroff_when_done" = yes ] && poweroff
		exit 1
	fi

	echo "Starting HVX stress test ($iterations iterations)..."
	/usr/bin/hvx-stress-run -n "$iterations"
	rc=$?

	if [ "$poweroff_when_done" = yes ]; then
		# Give the console a moment to drain before the machine goes.
		sync
		poweroff
	fi

	return $rc
}

case "$1" in
	start)
		start
		;;
	stop)
		;;
	restart|reload)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
