config BR2_PACKAGE_OPENCL_ICD_LOADER
	bool "opencl-icd-loader"
	depends on !BR2_STATIC_LIBS # dlfcn.h
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_OPENCL_HEADERS
	select BR2_PACKAGE_HAS_LIBOPENCL
	help
	  OpenCL Installable Client Driver (ICD) Loader from Khronos.
	  This allows multiple OpenCL implementations to coexist.

	  https://github.com/KhronosGroup/OpenCL-ICD-Loader

config BR2_PACKAGE_PROVIDES_LIBOPENCL
	default "opencl-icd-loader" if BR2_PACKAGE_OPENCL_ICD_LOADER

comment "opencl-icd-loader needs a toolchain w/ dynamic library, threads"
	depends on BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS
