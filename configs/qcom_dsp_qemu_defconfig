BR2_hexagon=y
BR2_HEXAGON_v73=y
BR2_SHARED_LIBS=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_CLANG=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://artifacts.codelinaro.org/artifactory/codelinaro-toolchain-for-hexagon/23.1.0-rc1/clang+llvm-23.1.0-rc1-cross-hexagon-unknown-linux-musl.tar.zst"
BR2_TOOLCHAIN_EXTERNAL_REL_BIN_PATH="x86_64-ubuntu-22.04/bin"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="hexagon-unknown-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_CLANG_23_0=y
BR2_TOOLCHAIN_EXTERNAL_GCC_12=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_13=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_POST_BUILD_SCRIPT="board/qcom/sa8775/post_build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/qcom/sa8775/post_image.sh"
BR2_ROOTFS_OVERLAY="board/qcom/sa8775/rootfs-overlay"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# Enables telnetd (see board/qcom/sa8775/busybox.fragment).
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/qcom/sa8775/busybox.fragment"
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_LOCKDEV=n
BR2_PACKAGE_LIBEVENT=n
BR2_PACKAGE_ATFTP=n
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LSH=y
# rsh/rshd (rsh-redone) is dropped for now: it needs PAM, and linux-pam's
# libpam.map version script uses dependent version nodes that the eld linker
# in the 22.1.8 toolchain didn't support (see ./libpam_eld_bug). This defconfig
# now uses ld.lld by default (BR2_HEXAGON_USE_ELD is off), which doesn't have
# this bug, but hasn't been re-tested with rsh-redone yet. telnetd
# (board/qcom/sa8775/busybox.fragment) is the sole dropbear SSH fallback for
# now.
# BR2_PACKAGE_RSH_REDONE is not set

BR2_PACKAGE_BASH=y
BR2_PACKAGE_ZSH=y

# liquid-dsp's src/math/src/poly.c triggers a clang-23 hexagon compile-time
# blowup at -O2 (compiles in ~0.3s at -O0, does not terminate at -O2). Disabled
# to unblock the Mesa3D work; reproducer preserved in ./compile_time_bug_poly_c.
# BR2_PACKAGE_LIQUID_DSP is not set
# dav1d's meson build unconditionally links -latomic when
# BR2_TOOLCHAIN_HAS_LIBATOMIC=y, but this toolchain has no libatomic.a
# (atomics are covered by compiler builtins/musl), so the link fails.
# BR2_PACKAGE_DAV1D is not set
BR2_PACKAGE_CMAKE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_GNURADIO_FFT=y
BR2_PACKAGE_EIGEN=y

BR2_RELRO_NONE=y

BR2_PACKAGE_XINETD=n
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_COREMARK=y
BR2_PACKAGE_HEXAGONMVM=n

# Mesa3D/LLVM/Rust (RustiCL OpenCL) are disabled for now -- rebuilding
# without them to isolate the libc-test/hvx-stress bring-up from that much
# larger, slower dependency chain.
# BR2_PACKAGE_MESA3D is not set
# BR2_PACKAGE_HOST_RUST is not set
# BR2_PACKAGE_CLINFO is not set
# HVX vector unit and kernel HVX context save/restore stress test. Started
# from board/qcom/sa8775/rootfs-overlay/etc/init.d/S99hvx-stress, but only
# when "hvxstress[=N]" appears on the kernel command line, so ordinary boots
# are unaffected. Requires CONFIG_HEXAGON_HVX=y in the kernel, which the
# qemu_defconfig enables.
BR2_PACKAGE_HVX_STRESS=y
# musl's own conformance/regression test suite, cross-built and installed
# to /usr/lib/libc-test/ for the user to run on-target. See
# package/libc-test/Config.in.
BR2_PACKAGE_LIBC_TEST=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
# The full rootfs is no longer embedded into the kernel as an initramfs.
# Instead it is written to a persistent ext2 disk image that QEMU exposes as
# a virtio-blk device (/dev/vda), mounted directly as root via root=/dev/vda
# (board/qcom/sa8775/linux.fragment) -- no initrd needed. ext2 -- not ext4 --
# is required: the kernel's qemu defconfig has CONFIG_EXT2_FS but not
# CONFIG_EXT4_FS. The size is padded well above the ~60MB rootfs so there is
# headroom for changes that persist across reboots.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_2r1=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
# Also emit a gzip-compressed copy (rootfs.ext2.gz) alongside the
# uncompressed image, for smaller distribution/storage.
BR2_TARGET_ROOTFS_EXT2_GZIP=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/bcain/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="hexagon-qemu-boot-glink-24-july-2026"
BR2_LINUX_KERNEL_DEFCONFIG="qemu"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/qcom/sa8775/linux.fragment"
