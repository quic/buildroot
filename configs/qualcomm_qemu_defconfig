BR2_hexagon=y
BR2_HEXAGON_v68=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/local/mnt/workspace/.buildroot-ccache"

BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CLANG=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://artifacts.codelinaro.org/artifactory/codelinaro-toolchain-for-hexagon/19.1.5/clang+llvm-19.1.5-cross-hexagon-unknown-linux-musl.tar.zst"
BR2_TOOLCHAIN_EXTERNAL_REL_BIN_PATH="x86_64-linux-gnu/bin"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="hexagon-unknown-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_7=y
BR2_TOOLCHAIN_EXTERNAL_CLANG_19_0=y
BR2_WGET="wget -nd -t 3 --connect-timeout=10 --remote-encoding=UTF-8"

BR2_LINUX_KERNEL=y
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_VMLINUX_BIN=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="git@gitlab.qualcomm.com:mathbern/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="boot-on-qemu"
BR2_LINUX_KERNEL_DEFCONFIG="qemu"

BR2_TARGET_ROOTFS_CPIO=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_PACKAGE_HEXAGON_H2=y
BR2_PACKAGE_HEXAGON_LINUX_LOADER=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_ROOTFS_OVERLAY="board/qualcomm/qemu/ramfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/qualcomm/qemu/copy-libc.sh"
